ENVIRONMENT=development
LOG_LEVEL=INFO
WEBHOOK_SECRET=replace-me
DATABASE_URL=postgresql://manualhook:manualhook@postgres:5432/manualhook
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=service-account@example.com
JIRA_API_TOKEN=replace-me
JIRA_PROJECT_KEY=OPS
JIRA_ISSUE_TYPE=Task
PROJECT_CONFIG=config/projects.yml

# Durable async queue / worker
QUEUE_ENABLED=true
WORKER_POLL_INTERVAL=2
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=5
WORKER_RETRY_BASE_SECONDS=2

# Elasticsearch / Kibana observability
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_URL=https://elasticsearch.example.com:443
ELASTICSEARCH_API_KEY=replace-me
ELASTICSEARCH_INDEX_PREFIX=gitlab-pipelines

# OpenTelemetry / OTLP collector
OTEL_ENABLED=false
OTEL_SERVICE_NAME=gitlab-jira-manual-hook
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_INSECURE=true
